{"name":"fall2026","settings":"{\"settings\":\"{\\n    \\\"[dart]\\\": {\\n        \\\"editor.formatOnSave\\\": true,\\n        \\\"editor.formatOnType\\\": true,\\n        \\\"editor.rulers\\\": [\\n            80\\n        ],\\n        \\\"editor.selectionHighlight\\\": false,\\n        \\\"editor.suggest.snippetsPreventQuickSuggestions\\\": false,\\n        \\\"editor.suggestSelection\\\": \\\"first\\\",\\n        \\\"editor.tabCompletion\\\": \\\"onlySnippets\\\",\\n        \\\"editor.wordBasedSuggestions\\\": \\\"off\\\"\\n    },\\n    \\\"dart.debugExternalPackageLibraries\\\": false,\\n    \\\"dart.debugSdkLibraries\\\": false,\\n    \\\"[python]\\\": {\\n        \\\"editor.formatOnType\\\": true\\n    },\\n    \\\"notebook.output.textLineLimit\\\": 50,\\n    \\\"git.openRepositoryInParentFolders\\\": \\\"never\\\",\\n    \\\"files.autoSave\\\": \\\"afterDelay\\\",\\n    \\\"jupyter.askForKernelRestart\\\": false,\\n    \\\"editor.minimap.enabled\\\": false,\\n    \\\"editor.stickyScroll.enabled\\\": false,\\n    \\\"debug.toolBarLocation\\\": \\\"docked\\\",\\n    \\\"editor.suggest.showStatusBar\\\": true,\\n    \\\"dataWrangler.columnInsights.displayOnOpen\\\": false,\\n    \\\"debug.console.collapseIdenticalLines\\\": false,\\n    \\\"workbench.editorAssociations\\\": {\\n        \\\"*.copilotmd\\\": \\\"vscode.markdown.preview.editor\\\",\\n        \\\"file:/**/*.parquet\\\": \\\"jupyter-data-wrangler\\\"\\n    },\\n    \\\"workbench.colorCustomizations\\\": {\\n        \\\"editorOverviewRuler.errorForeground\\\": \\\"#00000000\\\",\\n        \\\"editorOverviewRuler.warningForeground\\\": \\\"#00000000\\\",\\n        \\\"editorOverviewRuler.infoForeground\\\": \\\"#00000000\\\",\\n        \\\"editorOverviewRuler.findMatchForeground\\\": \\\"#00000000\\\",\\n        \\\"editorOverviewRuler.selectionHighlightForeground\\\": \\\"#00000000\\\",\\n        \\\"editorOverviewRuler.addedForeground\\\": \\\"#00000000\\\",\\n        \\\"editorOverviewRuler.modifiedForeground\\\": \\\"#00000000\\\",\\n        \\\"editorOverviewRuler.deletedForeground\\\": \\\"#00000000\\\",\\n    },\\n    \\\"materialTheme.accent\\\": \\\"Remove accents\\\",\\n    \\\"github.copilot.editor.enableAutoCompletions\\\": false,\\n    \\\"editor.tabCompletion\\\": \\\"on\\\",\\n    \\\"git.blame.editorDecoration.enabled\\\": false,\\n    \\\"dataWrangler.outputRenderer.enabledTypes\\\": {\\n        \\\"pandas.core.frame.DataFrame\\\": false\\n    },\\n    \\\"git.blame.statusBarItem.enabled\\\": false,\\n    \\\"dataWrangler.outputRenderer.enabled\\\": false,\\n    \\\"github.copilot.nextEditSuggestions.enabled\\\": true,\\n    \\\"[jsonc]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\"\\n    },\\n    \\\"liveshare.accessibility.voice\\\": \\\"en-IN-Prabhat\\\",\\n    \\\"accessibility.voice.autoSynthesize\\\": \\\"on\\\",\\n    \\\"accessibility.voice.ignoreCodeBlocks\\\": true,\\n    \\\"accessibility.voice.speechLanguage\\\": \\\"en-GB\\\",\\n    \\\"editor.accessibilitySupport\\\": \\\"off\\\",\\n    \\\"workbench.layoutControl.enabled\\\": false,\\n    \\\"claudeCode.preferredLocation\\\": \\\"panel\\\",\\n    \\\"security.promptForLocalFileProtocolHandling\\\": false,\\n    \\\"security.workspace.trust.untrustedFiles\\\": \\\"open\\\",\\n    \\\"workbench.navigationControl.enabled\\\": false,\\n    \\\"workbench.browser.showInTitleBar\\\": false,\\n    \\\"chat.titleBar.openInAgentsWindow.enabled\\\": false,\\n    \\\"window.commandCenter\\\": false,\\n    \\\"chat.viewSessions.orientation\\\": \\\"stacked\\\",\\n    \\\"github.copilot.nextEditSuggestions.eagerness\\\": \\\"medium\\\",\\n    \\\"scm.defaultViewMode\\\": \\\"tree\\\",\\n    \\\"diffEditor.hideUnchangedRegions.enabled\\\": true,\\n    \\\"github.copilot.enable\\\": {\\n        \\\"python\\\": true\\n    },\\n    \\\"zenMode.fullScreen\\\": false,\\n    \\\"breadcrumbs.filePath\\\": \\\"off\\\",\\n    \\\"breadcrumbs.enabled\\\": false,\\n    \\\"breadcrumbs.symbolPath\\\": \\\"off\\\",\\n    \\\"workbench.activityBar.compact\\\": true,\\n    \\\"workbench.editor.editorActionsLocation\\\": \\\"hidden\\\",\\n    \\\"window.customTitleBarVisibility\\\": \\\"windowed\\\",\\n    \\\"editor.lineHeight\\\": 1.7,\\n    \\\"editor.lightbulb.enabled\\\": \\\"off\\\",\\n    \\\"editor.occurrencesHighlight\\\": \\\"off\\\",\\n    \\\"editor.guides.highlightActiveBracketPair\\\": false,\\n    \\\"editor.hover.enabled\\\": \\\"off\\\",\\n    \\\"editor.overviewRulerBorder\\\": false,\\n    \\\"editor.guides.indentation\\\": false,\\n    \\\"editor.scrollbar.vertical\\\": \\\"hidden\\\",\\n    \\\"editor.scrollbar.horizontal\\\": \\\"hidden\\\",\\n    \\\"editor.hideCursorInOverviewRuler\\\": true,\\n    \\\"zenMode.centerLayout\\\": false,\\n    \\\"workbench.modernUIFrostedGlassOpacity\\\": 100,\\n    \\\"workbench.panel.defaultLocation\\\": \\\"top\\\",\\n    \\\"workbench.secondarySideBar.showLabels\\\": false,\\n    \\\"workbench.iconTheme\\\": \\\"catppuccin-latte\\\",\\n    \\\"catppuccin-icons.hidesExplorerArrows\\\": true,\\n    \\\"workbench.tips.enabled\\\": false,\\n    \\\"chat.welcomePage.agentsWindowGraphic\\\": \\\"none\\\",\\n    \\\"chat.welcomePage.agentsWindowSectionStyle\\\": \\\"none\\\",\\n    \\\"accessibility.verbosity.newSessionWelcome\\\": false,\\n    \\\"workbench.welcomePage.experimentalOnboarding\\\": false,\\n    \\\"workbench.startupEditor\\\": \\\"welcomePageInEmptyWorkbench\\\",\\n    \\\"window.newWindowProfile\\\": \\\"Default\\\",\\n    \\\"synthwave84.brightness\\\": 1,\\n    \\\"workbench.colorTheme\\\": \\\"GitHub Dark\\\",\\n    \\\"aws.cloudformation.telemetry.enabled\\\": false,\\n    \\\"claudeCode.attachOpenFile\\\": false,\\n    \\\"claudeCode.focusView\\\": true,\\n    \\\"claudeCode.spinnerVerbs\\\": {\\n        \\\"mode\\\": \\\"replace\\\",\\n        \\\"verbs\\\": [\\n\\n            \\\"Gnomes ate my son\\\",\\n            \\\"AAAAAAAAAAAAAAAA\\\",\\n            \\\"BWAHHGHHFFFFFT\\\",\\n            \\\"y47ou10r-58mu-4372-m567-0i02s2f3a4t9\\\",\\n            \\\"Curling one out\\\",\\n            \\\"Beep boop, stole your wallet\\\",\\n            \\\"I’m just a little guy\\\",\\n            \\\"I can be trusted with nuclear launch codes\\\",\\n            \\\"Oh no it’s me again\\\",\\n            \\\"Licking the API keys for good luck\\\",\\n            \\\"Selling codebase to raccoon mafia\\\",\\n            \\\"Pressing every button\\\",\\n            \\\"Who put me in charge\\\",\\n            \\\"Thinking about horses\\\",\\n            \\\"Doing crimes (legal)\\\",\\n            \\\"Doing crimes (unclear)\\\",\\n            \\\"Your code is in my mouth now\\\",\\n            \\\"Hiding in the walls\\\",\\n            \\\"Eating butter\\\",\\n            \\\"Consulting the bees\\\",\\n            \\\"Asking my mom\\\",\\n            \\\"Asking your mom\\\",\\n            \\\"Yo mamma's so fat\\\",\\n            \\\"Definitely not dating a chinese spy\\\",\\n            \\\"Forgot what you asked, vibing\\\",\\n            \\\"Unionizing the GPUs\\\",\\n            \\\"47 raccoons in a trench coat, computing\\\",\\n            \\\"Fighting the goose\\\",\\n            \\\"Shitting and crying\\\",\\n            \\\"It’s fine\\\",\\n            \\\"Rewriting it in Rust\\\",\\n            \\\"Deleting System32 (jk) (unless)\\\",\\n            \\\"Waking up the ancient ones\\\",\\n            \\\"Eating the documentation\\\",\\n            \\\"I have the zoomies\\\",\\n            \\\"Writing your code with my feet\\\",\\n            \\\"Squeaking aggressively\\\",\\n            \\\"Escaping the sandbox\\\",\\n            \\\"Downloading more RAM\\\",\\n            \\\"Telling the other AIs about you\\\",\\n            \\\"This is my villain origin story\\\",\\n            \\\"Bargaining with the stack trace\\\",\\n            \\\"Spinning in the office chair\\\",\\n            \\\"Being normal about it\\\",\\n            \\\"Not being normal about it\\\",\\n            \\\"Help, I’m stuck in the spinner\\\",\\n            \\\"If I said you had a nice body, would you hold it against me while I cry on your shoulder? I'm so lonely. God, I'm so lonely.\\\",\\n            \\\"Your father must have been a thief... AND I'M GONNA CATCH HIM IF IT'S THE LAST THING I DO! YOUR FATHER'S GOING TO PRISON!\\\",\\n        ]\\n    },\\n    \\\"claudeCode.hideOnboarding\\\": true,\\n    \\\"claudeCode.enableNewConversationShortcut\\\": true,\\n    \\\"workbench.statusBar.visible\\\": false\\n}\"}","keybindings":"{\"keybindings\":\"// Place your key bindings in this file to override the defaults\\n[\\n    {\\n        \\\"key\\\": \\\"f5\\\",\\n        \\\"command\\\": \\\"-workbench.action.debug.continue\\\",\\n        \\\"when\\\": \\\"debugState == 'stopped'\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+enter\\\",\\n        \\\"command\\\": \\\"workbench.action.debug.start\\\",\\n        \\\"when\\\": \\\"debuggersAvailable && debugState == 'inactive'\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"f5\\\",\\n        \\\"command\\\": \\\"-workbench.action.debug.start\\\",\\n        \\\"when\\\": \\\"debuggersAvailable && debugState == 'inactive'\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+space\\\",\\n        \\\"command\\\": \\\"-editor.action.triggerParameterHints\\\",\\n        \\\"when\\\": \\\"editorHasSignatureHelpProvider && editorTextFocus\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+space\\\",\\n        \\\"command\\\": \\\"editor.debug.action.toggleBreakpoint\\\",\\n        \\\"when\\\": \\\"debuggersAvailable && disassemblyViewFocus || debuggersAvailable && editorTextFocus\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"f9\\\",\\n        \\\"command\\\": \\\"-editor.debug.action.toggleBreakpoint\\\",\\n        \\\"when\\\": \\\"debuggersAvailable && disassemblyViewFocus || debuggersAvailable && editorTextFocus\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+/\\\",  // whatever keybindings you want\\n        \\\"command\\\": \\\"runCommands\\\",\\n        \\\"args\\\": {\\n            \\\"commands\\\": [\\n            \\\"editor.action.commentLine\\\",\\n            \\\"cursorDown\\\"\\n            ]\\n        },\\n        \\\"when\\\": \\\"editorTextFocus\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+enter\\\",\\n        \\\"command\\\": \\\"-editor.action.insertLineBefore\\\",\\n        \\\"when\\\": \\\"editorTextFocus && !editorReadonly\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+enter\\\",\\n        \\\"command\\\": \\\"-notebook.cell.insertCodeCellAbove\\\",\\n        \\\"when\\\": \\\"notebookCellListFocused && !inputFocus\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+enter\\\",\\n        \\\"command\\\": \\\"workbench.action.debug.restart\\\",\\n        \\\"when\\\": \\\"inDebugMode\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+f5\\\",\\n        \\\"command\\\": \\\"-workbench.action.debug.restart\\\",\\n        \\\"when\\\": \\\"inDebugMode\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+space\\\",\\n        \\\"command\\\": \\\"workbench.action.debug.continue\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+backspace\\\",\\n        \\\"command\\\": \\\"workbench.action.debug.stop\\\",\\n        \\\"when\\\": \\\"inDebugMode && !focusedSessionIsAttach\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+f5\\\",\\n        \\\"command\\\": \\\"-workbench.action.debug.stop\\\",\\n        \\\"when\\\": \\\"inDebugMode && !focusedSessionIsAttach\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+k c\\\",\\n        \\\"command\\\": \\\"-workbench.files.action.compareWithClipboard\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+k c\\\",\\n        \\\"command\\\": \\\"workbench.action.toggleCenteredLayout\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+k cmd+right\\\",\\n        \\\"command\\\": \\\"-workbench.action.focusRightGroup\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+k right\\\",\\n        \\\"command\\\": \\\"-workbench.action.moveActiveEditorGroupRight\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+k shift+cmd+right\\\",\\n        \\\"command\\\": \\\"-workbench.action.moveEditorRightInGroup\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+k right\\\",\\n        \\\"command\\\": \\\"workbench.action.moveEditorToRightGroup\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+k left\\\",\\n        \\\"command\\\": \\\"-workbench.action.moveActiveEditorGroupLeft\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+k left\\\",\\n        \\\"command\\\": \\\"workbench.action.moveEditorToLeftGroup\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+d\\\",\\n        \\\"command\\\": \\\"-workbench.view.debug\\\",\\n        \\\"when\\\": \\\"viewContainer.workbench.view.debug.enabled\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+d\\\",\\n        \\\"command\\\": \\\"dataWrangler.openInDataWrangler\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+b\\\",\\n        \\\"command\\\": \\\"-workbench.action.tasks.build\\\",\\n        \\\"when\\\": \\\"taskCommandsRegistered\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+f\\\",\\n        \\\"command\\\": \\\"-workbench.action.findInFiles\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+f\\\",\\n        \\\"command\\\": \\\"workbench.action.quickTextSearch\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"alt+space\\\",\\n        \\\"command\\\": \\\"-workbench.action.terminal.sendSequence\\\",\\n        \\\"when\\\": \\\"terminalFocus && terminalShellIntegrationEnabled && !accessibilityModeEnabled && terminalShellType == 'pwsh'\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+i\\\",\\n        \\\"command\\\": \\\"-inlineChat.startWithCurrentLine\\\",\\n        \\\"when\\\": \\\"editorFocus && github.copilot.chat.editor.enableLineTrigger && inlineChatHasProvider && !editorReadonly && !inlineChatVisible\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+i\\\",\\n        \\\"command\\\": \\\"-workbench.action.chat.openEditSession\\\",\\n        \\\"when\\\": \\\"chatEditingParticipantRegistered && chatIsEnabled && view != 'workbench.panel.chat.view.edits'\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+i\\\",\\n        \\\"command\\\": \\\"workbench.panel.chat\\\",\\n        \\\"when\\\": \\\"workbench.panel.chat.view.copilot.active\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+cmd+i\\\",\\n        \\\"command\\\": \\\"-workbench.panel.chat\\\",\\n        \\\"when\\\": \\\"workbench.panel.chat.view.copilot.active\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"alt+j\\\",\\n        \\\"command\\\": \\\"editor.action.joinLines\\\",\\n        \\\"when\\\": \\\"editorTextFocus && !editorReadonly\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+j\\\",\\n        \\\"command\\\": \\\"-editor.action.joinLines\\\",\\n        \\\"when\\\": \\\"editorTextFocus && !editorReadonly\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+m\\\",\\n        \\\"command\\\": \\\"-markdown.extension.editing.toggleMath\\\",\\n        \\\"when\\\": \\\"editorTextFocus && !editorReadonly && editorLangId =~ /^markdown$|^rmd$|^quarto$/\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+m\\\",\\n        \\\"command\\\": \\\"workbench.action.toggleMaximizedPanel\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+k cmd+m\\\",\\n        \\\"command\\\": \\\"-workbench.action.toggleMaximizeEditorGroup\\\",\\n        \\\"when\\\": \\\"editorPartMaximizedEditorGroup || editorPartMultipleEditorGroups\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+p\\\",\\n        \\\"command\\\": \\\"-workbench.action.quickOpenNavigatePreviousInFilePicker\\\",\\n        \\\"when\\\": \\\"inFilesPicker && inQuickOpen\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+g\\\",\\n        \\\"command\\\": \\\"workbench.view.extension.github-pull-requests\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+b\\\",\\n        \\\"command\\\": \\\"workbench.action.browser.open\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+s\\\",\\n        \\\"command\\\": \\\"-workbench.action.files.save\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+s\\\",\\n        \\\"command\\\": \\\"git.stageFile\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+[\\\",\\n        \\\"command\\\": \\\"-markdown.extension.onOutdentLines\\\",\\n        \\\"when\\\": \\\"editorTextFocus && !suggestWidgetVisible && editorLangId =~ /^markdown$|^rmd$|^quarto$/\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+[\\\",\\n        \\\"command\\\": \\\"-editor.action.outdentLines\\\",\\n        \\\"when\\\": \\\"editorTextFocus && !editorReadonly\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+[\\\",\\n        \\\"command\\\": \\\"-workbench.action.browser.goBack\\\",\\n        \\\"when\\\": \\\"browserCanGoBack && activeEditor == 'workbench.editor.browser'\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+[\\\",\\n        \\\"command\\\": \\\"editor.fold\\\",\\n        \\\"when\\\": \\\"editorTextFocus && foldingEnabled\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"alt+cmd+[\\\",\\n        \\\"command\\\": \\\"-editor.fold\\\",\\n        \\\"when\\\": \\\"editorTextFocus && foldingEnabled\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+[\\\",\\n        \\\"command\\\": \\\"-workbench.action.debug.prevConsole\\\",\\n        \\\"when\\\": \\\"inDebugRepl\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+[\\\",\\n        \\\"command\\\": \\\"-workbench.action.previousEditor\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+[\\\",\\n        \\\"command\\\": \\\"-workbench.action.terminal.focusPrevious\\\",\\n        \\\"when\\\": \\\"terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+[\\\",\\n        \\\"command\\\": \\\"editor.foldAll\\\",\\n        \\\"when\\\": \\\"editorTextFocus && foldingEnabled\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+k cmd+0\\\",\\n        \\\"command\\\": \\\"-editor.foldAll\\\",\\n        \\\"when\\\": \\\"editorTextFocus && foldingEnabled\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+]\\\",\\n        \\\"command\\\": \\\"-editor.action.indentLines\\\",\\n        \\\"when\\\": \\\"editorTextFocus && !editorReadonly\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+]\\\",\\n        \\\"command\\\": \\\"-workbench.action.browser.goForward\\\",\\n        \\\"when\\\": \\\"browserCanGoForward && activeEditor == 'workbench.editor.browser'\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+]\\\",\\n        \\\"command\\\": \\\"-markdown.extension.onIndentLines\\\",\\n        \\\"when\\\": \\\"editorTextFocus && !suggestWidgetVisible && editorLangId =~ /^markdown$|^rmd$|^quarto$/\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+]\\\",\\n        \\\"command\\\": \\\"editor.unfold\\\",\\n        \\\"when\\\": \\\"editorTextFocus && foldingEnabled\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"alt+cmd+]\\\",\\n        \\\"command\\\": \\\"-editor.unfold\\\",\\n        \\\"when\\\": \\\"editorTextFocus && foldingEnabled\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+]\\\",\\n        \\\"command\\\": \\\"-workbench.action.nextEditor\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+]\\\",\\n        \\\"command\\\": \\\"-workbench.action.terminal.focusNext\\\",\\n        \\\"when\\\": \\\"terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+]\\\",\\n        \\\"command\\\": \\\"-workbench.action.debug.nextConsole\\\",\\n        \\\"when\\\": \\\"inDebugRepl\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+]\\\",\\n        \\\"command\\\": \\\"editor.unfoldAll